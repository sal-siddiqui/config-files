# fcd <dir>
# Search for a directory fuzzily and `cd` into it
function fcd() {
	local dir
	dir=$(
		find . -type d -not -path '*/.*' -print 2> /dev/null |
			fzf.exe --prompt='cd '
	) || return 1
	[[ -n $dir ]] && cd "$dir"
}

# fnano <file...>
# Search for files fuzzily and open them with nano
function fnano() {
	local files=()
	mapfile -t files < <(
		find . -type f 2> /dev/null |
			fzf.exe --multi --prompt='nano '
	)

	((${#files[@]})) && nano -- "${files[@]}"
}

# hl <pattern...>
# Highlight patterns from the input stream
function hl() {
	local pattern
	pattern=$(printf '%s|' "$@")
	pattern="${pattern%|}"

	# The first "$" will match every line but not color it
	GREP_COLORS="mt=43" grep --color=always -E "${pattern}|$"
}

# dl <resource>
# List docker resources in an opioniated format
function dl() {
	local format
	local -A resource_map
	local -a cmd

	cmd=(docker)
	resource_map=(
		[i]=image
		[c]=container
	)

	case "$1" in
		i)
			format='table {{.Repository}}:{{.Tag}}\t{{.Containers}}\t{{.Size}}'
			cmd+=("${resource_map[$1]}" list --all --format "$format")
			;;
		c)
			format='table {{.Names}}\t{{.Image}}\t{{upper .State}}\t{{.Networks}}\t{{.Ports}}'
			cmd+=("${resource_map[$1]}" list --all --format "$format")
			;;
		*)
			echo 'Usage: dl <resource>'
			echo '  i -- images'
			echo '  c -- containers'
			return 1
			;;
	esac

	"${cmd[@]}"
}

# kl <resource...> [-n namespace]
# Wrapper for `kubectl get`
function kl() {
	if (($# == 0)); then
		echo 'Usage: kl <resource...> [-n namespace]'
		echo '  p   --- Pod'
		echo '  d   --- Deployment'
		echo '  s   --- Service'
		echo '  sts --- StatefulSet'
		echo '  ds  --- DaemonSet'
		return 1
	fi

	local -A resource_map=(
		[p]=pods
		[d]=deployment
		[s]=service
		[sts]=statefulset
		[ds]=daemonset
	)
	local resources=()
	local namespace

	while (($#)); do
		case "$1" in
			-n)
				namespace=$2
				shift
				;;
			*)
				if [[ -v "resource_map[$1]" ]]; then
					resources+=("${resource_map[$1]}")
				else
					printf "ERROR: Unknown resource: %s\n" "$1" >&2
					return 1
				fi
				;;
		esac
		shift
	done

	if (( ${#resources[@]} == 0 )); then
		echo "ERROR: No resources specified" >&2
		return 1
	fi

	local resource_list cmd=() IFS=,

	resource_list="${resources[*]}"; unset IFS
	cmd=(kubectl.exe get "$resource_list")

	if [[ -n $namespace ]]; then
		cmd+=(--namespace "$namespace")
	fi

	"${cmd[@]}"
}
