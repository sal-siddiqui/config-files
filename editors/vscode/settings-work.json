{
  // -- List of dependencies
  // Themes: theNestruo.dark-minus-theme, PKief.material-icon-theme
  // Tools: esbenp.prettier-vscode, formulahendry.code-runner, usernamehw.errorlens, ms-vscode-remote.remote-wsl, ms-vscode-remote.remote-containers
  // Python: ms-python.python, charliermarsh.ruff
  // HTML: vincaslt.highlight-matching-tag, anteprimorac.html-end-tag-labels
  // Jinja: wholroyd.jinja, noxiz.jinja-snippets, monosans.djlint
  // JavaScript: dbaeumer.vscode-eslint
  // Bash: timonwong.shellcheck, mads-hartmann.bash-ide-vscode
  // Docker: docker.docker, exiasr.hadolint
  // SQL: adpyke.vscode-sql-formatter

  // -- Editor
  "editor.fontFamily": "Code New Roman",
  "editor.fontSize": 15,
  "editor.guides.indentation": false,
  "editor.insertSpaces": false,
  "editor.lineHeight": 2,
  "editor.minimap.enabled": false,
  "editor.occurrencesHighlight": "off",
  "editor.selectionHighlight": false,
  "editor.stickyScroll.enabled": false,
  "editor.tabSize": 2,
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 100,
  "editor.showFoldingControls": "never",
  "editor.bracketPairColorization.enabled": false,
  "chat.disableAIFeatures": true,
  "window.commandCenter": false,
  "zenMode.centerLayout": false,
  "zenMode.hideLineNumbers": false,
  "breadcrumbs.enabled": false,
  "git.decorations.enabled": false,
  "scm.diffDecorations": "none",
  "editor.formatOnSave": false,
  "files.insertFinalNewline": false,
  "files.trimTrailingWhitespace": false,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "always",
  },
  "workbench.activityBar.location": "hidden",
  "workbench.editor.enablePreview": false,
  "workbench.layoutControl.enabled": false,
  "workbench.sideBar.location": "right",
  "workbench.statusBar.visible": false,
  "workbench.startupEditor": "none",
  "workbench.colorTheme": "Dark- (Visual Studio) (Flat UI)",
  "workbench.colorCustomizations": {
    "[Dark- (Visual Studio) (Flat UI)]": {
      "terminal.background": "#1e1e1e",
      "panel.background": "#1e1e1e",
      "sideBar.background": "#1e1e1e",
      "sideBar.border": "#0000",
      "panel.border": "#0000",
      "scrollbar.shadow": "#0000",
    },
  },
  "workbench.iconTheme": "material-icon-theme",
  "workbench.tree.renderIndentGuides": "none",
  "workbench.tree.enableStickyScroll": false,
  "material-icon-theme.folders.theme": "classic",
  "material-icon-theme.hidesExplorerArrows": true,

  // -- Terminal
  "terminal.integrated.fontSize": 15,
  "terminal.integrated.lineHeight": 1.5,
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.shellIntegration.decorationsEnabled": "never",
  "terminal.integrated.stickyScroll.enabled": false,
  "terminal.integrated.initialHint": false,

  // -- Languages
  "[json][jsonc][yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },

  // -- Extensions
  "errorLens.messageBackgroundMode": "none",
  "bashIde.shellcheckPath": "shellcheck.exe",
  "bashIde.shfmt.path": "shfmt.exe",
  "bashIde.shfmt.caseIndent": true,
  "bashIde.shfmt.spaceRedirects": true,
}
