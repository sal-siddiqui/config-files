# Nano configuration file

# -- Layout
set linenumbers
set minibar
set nohelp

# -- Editor
set tabsize 2
set autoindent
set softwrap
set atblanks

# -- Colors
set numbercolor     gray,normal    # numbers
set minicolor       normal,normal  # minibar
set spotlightcolor  black,white    # search
set selectedcolor   white,black    # highlighting
set promptcolor     white,normal   # prompt
set statuscolor     black,white    # messages
set errorcolor      black,white    # error messages
set keycolor        gray,normal    # keyboard shortcuts
set functioncolor   white,normal   # keyboard shortcuts actions

# -- Keybindings
bind ^F forward main
bind M-F nextword main
bind ^B back main
bind M-B prevword main
bind ^Z suspend main
bind M-* "{execute}|| printf "\033]52;c;%s\007" "$(base64 | tr -d '\n')" {enter}{undo}" main
