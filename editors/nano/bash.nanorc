# Copied from https://github.com/serialhex/nano-highlight
# Modifed by Salman Siddiqui

# Identifier
syntax "bash" "\.bash$" "\.bash_(profile|aliases|functions|login|logout)$" "(\.|/)profile$"
header "^#!.*/(ba|k|pdk)?sh[-0-9_]*"

# Linter & Formatter
linter "shellcheck -f gcc"
formatter "shfmt --write"

# Control
color yellow "\<(if|else|for|function|case|esac|in|select|until|while|do|elif|then|set|\.|done|fi|return)\>"

# Strings
color lightblack "\"(\\.|[^\"])*\""
color lightblack "'(\\.|[^\'])*'"

# Comments
color lightblack "#.*$"
